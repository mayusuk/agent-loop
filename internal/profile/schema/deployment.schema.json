{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mayusuk/agent-loop/internal/profile/schema/deployment.schema.json",
  "title": "agent-loop deployment config (~/.config/agent-loop/deployment.toml)",
  "description": "TECHNICAL-SPEC §13. Key names and defaults are D14 of the issue #9 work plan.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "temporal": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "address": {
          "$ref": "#/$defs/hostPort"
        },
        "namespace": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "projection": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "api": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "socket": {
          "type": "string",
          "minLength": 1
        },
        "gateway": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "address": {
              "$ref": "#/$defs/hostPort"
            },
            "token": {
              "type": "string",
              "pattern": "^secret://\\S+$"
            }
          }
        }
      }
    },
    "notifiers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "desktop",
          "tracker"
        ]
      }
    },
    "secrets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "backend": {
          "enum": [
            "keychain",
            "envfile"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "agent_runs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      }
    },
    "projects": {
      "type": "object",
      "patternProperties": {
        "^[A-Za-z0-9][A-Za-z0-9._-]*$": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "profile"
          ],
          "properties": {
            "profile": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "hostPort": {
      "type": "string",
      "pattern": "^(\\[[0-9A-Fa-f:.]+\\]|[A-Za-z0-9.-]+):[0-9]{1,5}$"
    }
  }
}
